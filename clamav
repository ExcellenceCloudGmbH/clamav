#!/bin/sh
set -eu

trap 'echo "signal caught; shutting down..."; exit 2;' QUIT TERM INT

command=${1:-clamd}
case $command in

clamd)
  clamd
  exit $?
  ;;

freshclam)
  freshclam -d
  exit $?
  ;;

scan)
  if [[ -z ${2:-} ]]; then
    clamdscan /
  else
    shift
    clamdscan "$@"
  fi
  exit $?
  ;;

*)
  exec "$@"
  exit 4
  ;;

esac
exit 0
